#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\embedded\rm27_training_framework_hw\build\codex-m2006-batch-a && C:\mingw64\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\embedded\rm27_training_framework_hw\build\codex-m2006-batch-a && C:\mingw64\bin\cmake.exe --regenerate-during-build -SD:\embedded\rm27_training_framework_hw\board -BD:\embedded\rm27_training_framework_hw\build\codex-m2006-batch-a"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

