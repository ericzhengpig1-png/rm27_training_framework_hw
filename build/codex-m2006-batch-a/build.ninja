  LINK_FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -T "D:/embedded/rm27_training_framework_hw/board/STM32F407XX_FLASH.ld" --specs=nano.specs -Wl,-Map=board.map -Wl,--gc-sections -Wl,--print-memory-usage
